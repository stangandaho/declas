QWidget {
    background-color: #2b2b2b;
    color: #ffffff;
}
QMenuBar, QMenu {
    background-color: #2b2b2b;
    color: #ffffff;
}
QMenuBar::item:selected, QMenu::item:selected,
QMenuBar::item:hover, QMenu::item:hover {
    background-color: #404040;
    color: #ffffff;
}
QLineEdit, QTextEdit, QPlainTextEdit, QAbstractItemView {
    background-color: #3b3b3b;
    color: #ffffff;
}
QTabBar::tab {
    color: #000000;
}
QPushButton {
    background-color: #555555;
    color: #ffffff;
}
QPushButton:hover {
    background-color: #777777;
}
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 2px;
}
QToolButton:hover {
    background-color: #1a3a5c;
    border-color: #3a7abf;
}
QToolButton:checked {
    background-color: #1a4d7a;
    border-color: #0078d4;
}
QToolButton:pressed {
    background-color: #0f3a60;
    border-color: #0078d4;
}
